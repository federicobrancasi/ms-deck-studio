{
	"name": "ms-deck-studio",
	"version": "0.1.0",
	"private": true,
	"description": "Microsoft-style slide decks as code: slides as plain data, built to a checked 16:9 PDF with speaker notes.",
	"type": "module",
	"license": "MIT",
	"author": "Federico Brancasi",
	"scripts": {
		"build": "node src/build.mjs",
		"new": "node src/new.mjs",
		"review": "node src/review.mjs",
		"pptx": "node src/pptx.mjs",
		"guide": "node src/build.mjs --deck specimens --no-pdf && node src/build.mjs --deck guide && node src/handout.mjs --deck guide",
		"examples": "node src/build-all.mjs examples",
		"gallery": "node src/gallery.mjs",
		"site": "node src/site.mjs",
		"handout": "node src/handout.mjs",
		"links": "node src/check-links.mjs",
		"privacy": "node src/privacy.mjs",
		"decks": "node -e \"import('./src/decks.mjs').then(m=>console.log(m.listDecks().join('\\n')))\""
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@fluentui/svg-icons": "^1.1.343",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"playwright-core": "^1.63.0",
		"pptxgenjs": "^4.0.1",
		"qrcode": "^1.5.4",
		"shiki": "^4.5.0"
	},
	"devDependencies": {
		"jsqr": "^1.4.0",
		"pngjs": "^7.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/federicobrancasi/ms-deck-studio.git"
	}
}
